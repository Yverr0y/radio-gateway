          "16": {
            "id": 16,
            "name": "sdr2",
            "data": {
              "id": "sdr2",
              "type": "listen"
            },
            "class": "bus-listen recording",
            "html": "<span class=\"rec-dot\" title=\"Loop recording\"></span><span class=\"bus-name\" data-bus=\"sdr2\" ondblclick=\"renameBus(this,'sdr2')\">SDR2</span> <span class=\"bus-type-tag\">(listen)</span>\n<div class=\"box\"><div class=\"proc-buttons\"><button class=\"proc-btn\" onclick=\"toggleProc('sdr2','gate')\" id=\"proc-sdr2-gate\" title=\"Noise Gate\">G</button><button class=\"proc-btn on\" onclick=\"toggleProc('sdr2','hpf')\" id=\"proc-sdr2-hpf\" title=\"High Pass Filter\">H</button><button class=\"proc-btn on\" onclick=\"toggleProc('sdr2','lpf')\" id=\"proc-sdr2-lpf\" title=\"Low Pass Filter\">L</button><button class=\"proc-btn on\" onclick=\"toggleProc('sdr2','notch')\" id=\"proc-sdr2-notch\" title=\"Notch Filter\">N</button><button class=\"proc-btn on\" onclick=\"toggleProc('sdr2','dfn')\" id=\"proc-sdr2-dfn\" title=\"Neural Denoise (RNNoise)\">D</button><span class=\"proc-sep\"></span><button class=\"proc-btn out-btn\" onclick=\"toggleProc('sdr2','pcm')\" id=\"proc-sdr2-pcm\" title=\"Feed PCM stream\">P</button><button class=\"proc-btn out-btn\" onclick=\"toggleProc('sdr2','mp3')\" id=\"proc-sdr2-mp3\" title=\"Feed MP3 stream\">M</button><button class=\"proc-btn out-btn\" onclick=\"toggleProc('sdr2','vad')\" id=\"proc-sdr2-vad\" title=\"VAD gate\">V</button><button class=\"proc-btn out-btn on\" onclick=\"toggleProc('sdr2','loop')\" id=\"proc-sdr2-loop\" title=\"Loop record\">R</button><span class=\"flex-spacer\"></span><button class=\"mute-btn\" onclick=\"toggleBusMute('sdr2')\" id=\"bus-mute-sdr2\" title=\"Mute bus\">M</button></div><div class=\"dfn-mix-row\" id=\"dfn-mix-row-sdr2\"><button class=\"dfn-engine-pill\" id=\"dfn-engine-sdr2\" data-engine=\"rnnoise\" title=\"Click to swap denoise engine (RNNoise \u2194 DeepFilterNet)\" onmousedown=\"event.stopPropagation()\" onpointerdown=\"event.stopPropagation()\" ontouchstart=\"event.stopPropagation()\" onclick=\"event.stopPropagation(); toggleDfnEngine('sdr2')\">RNN</button><span class=\"dfn-mix-label\">mix</span><input type=\"range\" class=\"dfn-mix-slider\" min=\"0\" max=\"1\" step=\"0.05\" value=\"0.45\" id=\"dfn-mix-sdr2\" oninput=\"setDfnMix('sdr2', this.value, true)\" onchange=\"setDfnMix('sdr2', this.value, false)\" ondblclick=\"this.value=0.5;setDfnMix('sdr2', 0.5, false)\"><span class=\"dfn-mix-val\" id=\"dfn-mix-val-sdr2\">45%</span><span class=\"dfn-atten-wrap\" id=\"dfn-atten-wrap-sdr2\" style=\"display:none\"><span class=\"dfn-mix-label\" title=\"Attenuation cap (dB). 0=unlimited, 15\u201325 typical. Stops pumping.\">cap</span><input type=\"number\" class=\"dfn-atten-input\" min=\"0\" max=\"60\" step=\"1\" value=\"18\" id=\"dfn-atten-sdr2\" onmousedown=\"event.stopPropagation()\" onpointerdown=\"event.stopPropagation()\" onchange=\"setDfnAtten('sdr2', this.value)\"><span class=\"dfn-mix-label\">dB</span></span></div><div class=\"level-bar\" id=\"level-bus_sdr2\"><div class=\"level-fill\"></div></div></div>",
            "typenode": false,
            "inputs": {
              "input_1": {
                "connections": [
                  {
                    "node": "2",
                    "input": "output_1"
                  }
                ]
              }
            },
            "outputs": {
